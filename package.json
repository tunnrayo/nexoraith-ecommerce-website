{
  "name": "nexoraith-store",
  "version": "0.10.0",
  "private": true,
  "description": "Nexoraith Absolute Ventures Ltd - e-commerce storefront, orders, payments and supplier groundwork",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "import": "node scripts/import-catalog.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "images:check": "node scripts/images.js check",
    "images:download": "node scripts/images.js download",
    "catalogue:remove-demo": "node scripts/remove-demo-catalogue.js",
    "catalogue:import": "node scripts/import-approved-catalogue.js",
    "setup:local": "node scripts/setup-local.js",
    "qa:browser": "node scripts/qa-browser.js"
  }
}
