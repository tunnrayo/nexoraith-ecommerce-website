# Copy this file to ".env" (same folder) and fill in values. NEVER commit ".env" or share it.
# Lines starting with # are comments.

# --- General ---
# "development" for your computer, "production" on the live server
NODE_ENV=development
PORT=3000
# The public address of the website, no trailing slash. Used for payment return links and the sitemap.
SITE_URL=http://localhost:3000
# Where the database file lives. Default is data/nexoraith.db
DATABASE_PATH=data/nexoraith.db

# Uploaded product images (Admin > Products > Images). On a host, put this on the same persistent disk as the database,
# e.g. UPLOAD_DIR=/data/uploads. Default is data/uploads
UPLOAD_DIR=

# --- Demonstration / presentation mode ---
# true = show demo products, allow the preliminary (unconfirmed) delivery fees, and offer a clearly labelled
# "Demonstration checkout" that completes an order WITHOUT taking money. Demo orders can never become "paid".
# Default: ON on your computer, OFF when NODE_ENV=production. For a presentation website set DEMO_MODE=true.
# Set DEMO_MODE=false (or delete it) before real trading.
DEMO_MODE=

# --- First admin (optional, for hosting without a terminal) ---
# If NO admin exists yet when the server starts, it creates one with these. Password: 12+ characters.
# After the first start, delete ADMIN_PASSWORD from your host's variables. Ignored once any admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Store settings (decisions still to be confirmed by the business) ---
STORE_CURRENCY=NGN
STORE_LOCALE=en-NG
# Leave blank until the business supplies them. They are only shown on the site if filled in.
COMPANY_ADDRESS=
COMPANY_PHONE=
# Advanced overrides (normally leave blank; DEMO_MODE controls both). true = sample products can be ordered.
ALLOW_DEVELOPMENT_PRODUCTS=
# true = allow checkout even if delivery charges are marked "not confirmed" (development only).
ALLOW_UNCONFIRMED_DELIVERY=

# --- Paystack (payments) ---
# Get keys: Paystack dashboard > Settings > API Keys & Webhooks. Use the TEST secret key (sk_test_...) while developing.
# Secret key stays on the server only. Never put it in any public file.
PAYSTACK_SECRET_KEY=
# In the Paystack dashboard set the webhook URL to: SITE_URL/webhooks/paystack

# --- CJdropshipping ---
# CJ account > API Key Management > Generate. Needed only for product lookup / tracking checks.
CJ_API_KEY=
# Keep false. Setting true lets an admin send an order to CJ. Do not enable until you have tested with CJ and approved the workflow.
CJ_ALLOW_ORDER_SUBMISSION=false
