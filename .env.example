# Copy this file to ".env" (same folder) and fill in values. NEVER commit ".env" or share it.
# Lines starting with # are comments.

# --- General ---
# "development" for your computer, "production" on the live server
NODE_ENV=development
PORT=3000
# The public address of the website, no trailing slash. Used for payment return links and the sitemap.
SITE_URL=http://localhost:3000
# Where the database file lives. Default is data/nexoraith.db
DATABASE_PATH=data/nexoraith.db

# Uploaded product images (Admin > Products > Images). On a host, put this on the same persistent disk as the database,
# e.g. UPLOAD_DIR=/data/uploads. Default is data/uploads
UPLOAD_DIR=

# --- Test mode (your computer only) ---
# true = checkout is allowed even while delivery fees are not marked "confirmed". Never adds products.
# Default: ON on your computer, OFF when NODE_ENV=production.
DEMO_MODE=

# --- First admin (optional, for hosting without a terminal) ---
# If NO admin exists yet when the server starts, it creates one with these. Password: 12+ characters.
# After the first start, delete ADMIN_PASSWORD from your host's variables. Ignored once any admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Store settings (decisions still to be confirmed by the business) ---
STORE_CURRENCY=NGN
STORE_LOCALE=en-NG
# Leave blank until the business supplies them. They are only shown on the site if filled in.
COMPANY_ADDRESS=
COMPANY_PHONE=
# true = products you ticked "Test product only" in Admin are shown and can be ordered (your own testing). Default false.
ALLOW_DEVELOPMENT_PRODUCTS=
# true = allow checkout even if delivery charges are marked "not confirmed" (development only).
ALLOW_UNCONFIRMED_DELIVERY=

# --- How orders work (can also be changed in Admin > Settings; Admin settings win) ---
# review_first = customer orders without paying; you check the exact items in the market, then request payment (default)
# pay_first    = customer pays at checkout; if an exact item can't be found you contact them and refund
PAYMENT_TIMING=review_first
# Estimated delivery = order confirmation date (payment verified) + this many calendar days
DELIVERY_ESTIMATE_DAYS=10
# Timezone used for the confirmation date and all dates shown (Nigeria = Africa/Lagos)
BUSINESS_TIMEZONE=Africa/Lagos

# --- Checkout testing ---
# The shop starts EMPTY. Add your products in Admin > Products. Nothing is ever imported automatically.
# true = also show customers a "Demonstration checkout (no payment)" option. For testing only; leave false.
DEMO_CHECKOUT=false

# --- Product images from other websites (optional) ---
# Normally leave empty and upload photos in Admin > Products. Only if you must link photos hosted elsewhere:
# space-separated https addresses, e.g. IMAGE_HOSTS=https://images.example.com
IMAGE_HOSTS=

# --- Email notifications (optional): https://resend.com ---
# Without these, nothing is emailed; customers still see every update on their order page.
# EMAIL_FROM must use a domain you have verified in Resend, e.g. Nexoraith <orders@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# Where YOU receive "new order" and "payment confirmed" alerts (also editable in Admin > Settings)
OWNER_NOTIFY_EMAIL=

# --- Paystack (payments) ---
# Get keys: Paystack dashboard > Settings > API Keys & Webhooks. Use the TEST secret key (sk_test_...) while developing.
# Secret key stays on the server only. Never put it in any public file.
PAYSTACK_SECRET_KEY=
# In the Paystack dashboard set the webhook URL to: SITE_URL/webhooks/paystack

# --- CJdropshipping (NOT used in the current business model; tools hidden unless SUPPLIER_INTEGRATION=cj) ---
SUPPLIER_INTEGRATION=
# CJ account > API Key Management > Generate. Needed only for product lookup / tracking checks.
CJ_API_KEY=
# Keep false. Setting true lets an admin send an order to CJ. Do not enable until you have tested with CJ and approved the workflow.
CJ_ALLOW_ORDER_SUBMISSION=false
